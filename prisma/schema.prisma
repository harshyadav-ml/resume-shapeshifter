// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client"
  output        = "../lib/generated/prisma"
  // native               = local macOS binary (dev)
  // linux-musl-openssl   = Vercel / Lambda / most Linux CI runtimes
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// NOTE (Prisma 7): datasource.url is no longer supported in schema.prisma.
// Connection URLs for Migrate are configured in prisma.config.ts.
// The PrismaClient receives its connection via the driver adapter in lib/db.ts.
datasource db {
  provider = "sqlite"
}

// Stores a complete tailoring run as JSON blob (fast, flexible)
model TailoringRunRecord {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  jobTitle      String
  company       String
  originalScore Int
  tailoredScore Int
  runJson       String   // full TailoringRun serialized as JSON

  exports       ExportedDocumentRecord[]
}

// Tracks exported PDFs
model ExportedDocumentRecord {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  runId     String
  type      String   // "tailored" | "comparison"
  filename  String

  run       TailoringRunRecord @relation(fields: [runId], references: [id], onDelete: Cascade)
}
