# =============================================
# Resume Shapeshifter — Environment Variables
# =============================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to git.
#
# Vercel deployment: add these in your Vercel project dashboard under
# Settings → Environment Variables. The only required variable is GROQ_API_KEY.

# ── Groq API ──────────────────────────────────
# Get your free key at: https://console.groq.com
# Model used: llama-3.1-8b-instant (fastest Groq model, ~300 tok/s)
# Variable name expected by Vercel: GROQ_API_KEY
GROQ_API_KEY=your_groq_api_key_here

# ── Database ──────────────────────────────────
# Local development uses SQLite (zero config).
# On Vercel (serverless), SQLite is unavailable at runtime — the /history
# page will be empty but the tailoring pipeline works fully.
# Leave this unset on Vercel; set it only for local dev.
DATABASE_URL="file:./prisma/dev.db"

# ── App URL ───────────────────────────────────
# Used for generating absolute URLs server-side.
# Local dev:   http://localhost:3000
# Production:  https://your-app.vercel.app  (or your custom domain)
NEXT_PUBLIC_APP_URL=http://localhost:3000
